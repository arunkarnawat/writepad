# build output
dist/

# Astro cache + generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# environment variables (keep examples like .env.example committed)
.env
.env.*
!.env.example

# macOS / Windows
.DS_Store
Thumbs.db

# editors
.idea/
.claude/
.cursor/

# vscode: keep shared bits, ignore per-developer settings
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json

# test / lint caches
coverage/
.eslintcache
.cache/

# typescript incremental build
*.tsbuildinfo

# alternate package-manager lockfiles (project uses npm)
pnpm-lock.yaml
yarn.lock
