---
import '@/styles/tailwind.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Writepad — Write anything, instantly',
  description = 'A fast, distraction-free writing pad in your browser. No account, no login — just write.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://writepad.org');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Pre-paint script: apply persisted theme + mode before first frame -->
    <script is:inline>
      (function () {
        var prefix = 'writepad.';
        try {
          var rawTheme = localStorage.getItem(prefix + 'theme');
          if (rawTheme) {
            var t = JSON.parse(rawTheme);
            if (t.preset) document.documentElement.setAttribute('data-theme', t.preset);
            if (t.overrides) {
              var s = document.documentElement.style;
              for (var k in t.overrides) s.setProperty(k, t.overrides[k]);
            }
          }

          var rawMode = localStorage.getItem(prefix + 'mode');
          document.documentElement.setAttribute('data-mode', rawMode || 'write');
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[9999] focus:px-4 focus:py-2 focus:rounded-md focus:bg-bg focus:text-fg focus:border focus:border-rule focus:shadow-pop focus:font-ui focus:text-sm"
    >
      Skip to content
    </a>
    <noscript>
      <div style="max-width:640px;margin:4rem auto;padding:1.5rem 1.25rem;font-family:system-ui,-apple-system,sans-serif;line-height:1.6;color:#111;background:#f6f6f6;border-radius:10px;">
        <h1 style="margin:0 0 .5rem;font-size:1.25rem;">Writepad needs JavaScript</h1>
        <p style="margin:0;color:#444;">
          Writepad is a fully client-side editor — your document is stored in the URL hash and processed in your browser.
          Please enable JavaScript to start writing.
        </p>
      </div>
    </noscript>
    <slot />
  </body>
</html>
